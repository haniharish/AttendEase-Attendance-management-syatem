# ===================================================
# AttendEase Docker Environment Configuration
# ===================================================

# Service Port Mapping (Host Ports)
FRONTEND_PORT=5176
BACKEND_PORT=6000
MONGODB_PORT=27018

# Application Ports & Environment
PORT=6000
NODE_ENV=production

# MongoDB Connection String
# Default connects to the internal docker mongodb container service
# For MongoDB Atlas, replace with your Atlas connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/attendease?retryWrites=true&w=majority
MONGODB_URI=mongodb://mongodb:27017/attendease

# JWT Secret Key (replace with minimum 32 characters in production)
JWT_SECRET=your_production_secure_jwt_secret_key_minimum_32_characters

# Client Origin URL for CORS
CLIENT_URL=http://localhost:5176

# Nagios Core Monitoring Service Configuration
NAGIOS_PORT=8080
NAGIOS_USER=nagiosadmin
NAGIOS_PASS=AdminPassword123!
NAGIOS_TIMEZONE=UTC
NAGIOS_STATUS_FILE=/opt/nagios/var/status.dat
NAGIOS_CGI_URL=http://nagios:80/nagios/cgi-bin
