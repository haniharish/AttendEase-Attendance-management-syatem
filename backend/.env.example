# AttendEase Backend Environment Variables
PORT=6000
MONGODB_URI=mongodb://127.0.0.1:27017/attendease
JWT_SECRET=your_jwt_secret_key_here_minimum_32_chars
CLIENT_URL=http://localhost:5176
NODE_ENV=development

# Nagios Monitoring Configuration (Optional for local development; configured in Docker)
NAGIOS_STATUS_FILE=/opt/nagios/var/status.dat
NAGIOS_CGI_URL=http://localhost:8080/nagios/cgi-bin
