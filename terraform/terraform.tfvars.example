# ==============================================================================
# AttendEase - Example Terraform Variable Values
# Copy this file to terraform.tfvars to customize your deployment.
# ==============================================================================

aws_region         = "ap-south-1"
project_name       = "attendease"
environment        = "production"
vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"
availability_zone  = "ap-south-1a"
instance_type      = "t3.micro"
volume_size        = 20
key_name           = "attendease-key"

# Change this to your public IPv4 address (run: curl https://checkip.amazonaws.com)
admin_ip           = "49.156.96.20/32"
